@page "/Account/RegisterConfirmation"
@using Microsoft.AspNetCore.Identity
@using SimpleXflow.Infrastructure.Identity
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager Navigation

<PageTitle>Confirm your email</PageTitle>
<AccountFormShell>
    <h1>Confirm your email</h1>
    @if (EmailSender is IdentityEmailSender { IsConfigured: false })
    {
        <p class="account-notice" role="status">Email delivery is not configured on this installation. Contact the administrator to enable confirmation emails before accepting workspace invitations.</p>
    }
    else
    {
        <p class="account-intro">If a confirmation email was requested, use the link in your inbox. For your security, confirmation links are never displayed here.</p>
    }
    <div class="account-links">
        <a href="@ResendUrl">Request another confirmation email</a>
        <a href="@LoginUrl">Log in</a>
    </div>
</AccountFormShell>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string ResendUrl => Navigation.GetUriWithQueryParameters("/Account/ResendEmailConfirmation", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl });
    private string LoginUrl => Navigation.GetUriWithQueryParameters("/Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl });
}
