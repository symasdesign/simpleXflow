@using Microsoft.AspNetCore.Components.Sections

<details class="global-navigation" onkeydown="if(event.key === 'Escape') { this.open = false; this.querySelector('summary').focus(); }">
    <summary role="button" aria-label="Open navigation" aria-controls="main-navigation" title="Navigation"><span aria-hidden="true">☰</span></summary>
    <button class="navigation-backdrop" aria-label="Close navigation" onclick="this.closest('details').open = false"></button>
    <nav id="main-navigation" class="navigation-drawer" aria-label="Main navigation">
        <AuthorizeView>
            <Authorized><NavLink href="workspaces">Workspaces</NavLink></Authorized>
        </AuthorizeView>
        <NavLink href="help">Help</NavLink>
        <AuthorizeView>
            <Authorized><a href="Account/Manage" data-enhance-nav="false">Account settings</a></Authorized>
        </AuthorizeView>
    </nav>
</details>
<a class="app-brand" href="" aria-label="simpleXflow home"><img src="brand/simplexflow-mark.svg" alt="" /><span>simple<b>X</b>flow</span></a>
<div class="context-navigation"><SectionOutlet SectionName="context-navigation" /></div>
<div class="account-navigation">
    <a class="help-link" href="help" aria-label="Help" title="Help">?</a>
    <AuthorizeView>
        <Authorized>
            <details class="account-menu">
                <summary><span class="avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span><span class="account-name">@context.User.Identity?.Name</span></summary>
                <div class="account-dropdown">
                    <a href="workspaces">My organization</a>
                    <a href="Account/Manage" data-enhance-nav="false">Account settings</a>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit">Logout</button>
                    </form>
                </div>
            </details>
        </Authorized>
        <NotAuthorized>
            <a href="Account/Login" data-enhance-nav="false">Log in</a>
            <a class="register-link" href="Account/Register" data-enhance-nav="false">Create account</a>
        </NotAuthorized>
    </AuthorizeView>
</div>
@code {
    private static string Initial(string? name) => string.IsNullOrEmpty(name) ? "U" : name[..1].ToUpperInvariant();
}
