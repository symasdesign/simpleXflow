@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header" onclick="if(event.target.closest('a')) this.querySelectorAll('details[open]').forEach(menu => menu.open = false)"><NavMenu /></header>
    <main id="main-content"><article class="app-content">@Body</article></main>
</div>
<div id="blazor-error-ui" data-nosnippet role="alert">
    The connection was interrupted. <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss">×</button>
</div>
