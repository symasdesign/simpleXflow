@page "/projects"
@page "/projects/{ProjectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Sections
@using SimpleXflow.Web.Infrastructure
@using SimpleXflow.Application.Projects
@using SimpleXflow.Application.Workspaces
@using SimpleXflow.Web.Components.Collaboration
@implements IAsyncDisposable
@inject IFlowProjectService ProjectService
@inject IWorkspaceService WorkspaceService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>@form.Name · simpleXflow</PageTitle>
<NavigationLock ConfirmExternalNavigation="@hasUnsavedChanges" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<SectionContent SectionName="context-navigation">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="workspaces" title="Workspaces">@(organization?.Name ?? "Workspaces")</a>
        @if (workspace is not null) { <span>/</span><a href="@($"workspaces/{workspace.Id}")">@workspace.Name</a> }
        @if (container is not null) { <span>/</span><a href="@ContainerHref">@container.Name</a> }
        @if (!string.IsNullOrEmpty(form.FolderPath)) { <span>/</span><a href="@($"{ContainerHref}?folder={Uri.EscapeDataString(form.FolderPath)}")">@form.FolderPath</a> }
        <span>/</span><span aria-current="page" title="@form.Name">@form.Name</span>
    </nav>
</SectionContent>
<div class="model-page">
    <section class="@(showFiles ? "workspace-shell model-workspace with-files" : "workspace-shell model-workspace")">
        @if (showFiles)
        {
            <aside class="project-list">
                <div class="panel-heading"><div><span class="eyebrow">@container?.Name</span><h1>Models</h1></div>
                    <button type="button" class="icon-button" title="New model" disabled="@(!CanEdit)" @onclick="StartNewProjectAsync">+</button>
                </div>
                <nav class="project-nav" aria-label="simpleXflow models">
                    @foreach (var project in projects.Where(p => p.WorkspaceProjectId == model?.WorkspaceProjectId))
                    {
                        <button type="button" class="@GetProjectRowClass(project.Id)" @onclick="() => SelectModelAsync(project.Id)"><span>@project.Name</span><small>@(string.IsNullOrEmpty(project.FolderPath) ? "/" : project.FolderPath)</small></button>
                    }
                </nav>
                <a class="sidebar-note" href="@ContainerHref">Manage models and folders ↗</a>
            </aside>
        }
        <section class="@EditorPanelClass">
            <div class="editor-toolbar compact-toolbar">
                <button type="button" class="icon-button" title="Toggle model list" aria-label="Toggle model list" @onclick="() => showFiles = !showFiles">☰</button>
                <div class="project-meta-form model-name"><label class="visually-hidden" for="model-name">Model name</label><input id="model-name" type="text" value="@form.Name" @oninput="OnNameChangedAsync" disabled="@(!CanEdit || isImporting || isSwitchingModel)" maxlength="240" /></div>
                <div class="toolbar-actions">
                    <span class="@AutoSaveIndicatorClass" aria-live="polite">@AutoSaveText</span>
                    @if (presence.Count > 0) { <span class="presence-badge" title="@string.Join(", ", presence.Select(p => p.Email))">@presence.Count viewing</span> }
                    <button type="button" class="secondary-action" data-model-name="@form.Name" onclick="simpleXflowFiles.saveModel(this)">Save locally…</button>
                    <button type="button" class="secondary-action" @onclick="ToggleCollaborationAsync" aria-expanded="@showCollaboration">History &amp; work</button>
                    <details class="model-actions">
                        <summary class="secondary-action">More</summary>
                        <div class="model-menu">
                            <button type="button" @onclick="ToggleFullScreen">@(isFullScreen ? "Exit full screen" : "Full screen")</button>
                            @if (CanEdit)
                            {
                                <label class="import-action">Import as new model<InputFile id="project-import-file" OnChange="ImportProjectAsync" accept=".bpmn,.xml,.zip,.sxf" class="import-file-input" /></label>
                                <button type="button" @onclick="OpenMove">Move to folder…</button>
                                <div class="sample-action">
                                    <label for="sample-select">Model template</label>
                                    <select id="sample-select" class="sample-select" @bind="selectedSampleId" aria-label="Model template">
                                        <option value="">Choose template…</option>
                                        @foreach (var sample in ProjectSamples.All) { <option value="@sample.Id">@sample.Name</option> }
                                    </select>
                                    <small>Examples for replacing this model. Your saved models are in the model list.</small>
                                    <button type="button" class="secondary-action" @onclick="RequestSampleLoadAsync" disabled="@string.IsNullOrWhiteSpace(selectedSampleId)">Load template</button>
                                </div>
                            }
                            @if (model?.CanManage == true) { <button type="button" class="danger-text" @onclick="() => confirmDelete = true">Delete model…</button> }
                        </div>
                    </details>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(statusMessage)) { <div class="status-line" role="status">@statusMessage</div> }
            @if (!CanEdit) { <div class="status-line">View only · Ask a workspace administrator for editing access.</div> }
            @if (!string.IsNullOrWhiteSpace(autosaveError)) { <div class="conflict-banner" role="alert">@autosaveError <button class="secondary-action" @onclick="() => AutosaveNowAsync()">Retry save</button><button class="secondary-action" @onclick="RequestReload">Reload saved model</button><span>Save a local copy before reloading if you want to keep your edits.</span></div> }
            <div class="model-body">
                <div class="@(!CanEdit ? "model-canvas is-readonly" : "model-canvas")">
                    <SimpleXflowModeler ProjectName="@form.Name" Xml="@form.BpmnXml" LogicXml="@form.LogicXml" LogicTargetElementId="@form.LogicTargetElementId" Revision="@editorRevision" IsFullScreen="@isFullScreen" ReadOnly="@(!CanEdit || isImporting || isSwitchingModel)" OnModelChanged="OnEditorModelChangedAsync" OnDirty="OnEditorDirtyAsync" />
                </div>
                @if (showCollaboration && model is not null && workspace is not null)
                {
                    <aside class="collaboration-drawer"><div class="panel-heading"><strong>History &amp; work</strong><button class="icon-button" aria-label="Close collaboration" @onclick="() => showCollaboration = false">×</button></div><ModelCollaboration Model="model" Workspace="workspace" OnChanged="ReloadModelAsync" BeforeChange="PrepareCollaborationAsync" /></aside>
                }
            </div>
        </section>
    </section>
</div>
@if (pendingSample is not null)
{
    <div class="confirmation-backdrop"><section class="confirmation-dialog" role="alertdialog" aria-modal="true" aria-labelledby="replace-sample-title">
        <span class="eyebrow">Model template</span><h2 id="replace-sample-title">Replace current model?</h2>
        <p>Loading <strong>@pendingSample.Name</strong> replaces this model and saves a new revision. Earlier changes remain in the history.</p>
        <div class="confirmation-actions"><button class="secondary-action" @onclick="CancelSampleLoad">Cancel</button><button class="primary-action" @onclick="ConfirmSampleLoadAsync">Replace model</button></div>
    </section></div>
}
@if (confirmDelete)
{
    <div class="confirmation-backdrop"><section class="confirmation-dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-title">
        <h2 id="delete-title">Delete @form.Name?</h2><p>The model, its attachments and version history will be permanently deleted. Save a local copy if you need to keep it.</p>
        <div class="confirmation-actions"><button class="secondary-action" @onclick="() => confirmDelete = false">Cancel</button><button class="danger-action" @onclick="DeleteAsync" disabled="@isSaving">Delete model</button></div>
    </section></div>
}
@if (showMove)
{
    <div class="confirmation-backdrop"><section class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="move-title">
        <h2 id="move-title">Move model</h2><label class="field-label">Folder path<input class="form-control" @bind="moveFolder" list="model-folders" placeholder="Processes/Sales (empty for project root)" /></label>
        <datalist id="model-folders">@foreach (var folder in container?.Folders ?? []) { <option value="@folder"></option> }</datalist>
        <div class="confirmation-actions"><button class="secondary-action" @onclick="CancelMove">Cancel</button><button class="primary-action" @onclick="MoveAsync">Move</button></div>
    </section></div>
}

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "sample")]
    public string? SampleId { get; set; }

    private readonly ProjectForm form = new();
    private const int AutosaveDelayMilliseconds = 1200;
    private static readonly TimeSpan EditorReadTimeout = TimeSpan.FromSeconds(5);
    private IReadOnlyList<ProjectSummary> projects = [];
    private ProjectDetail? model;
    private OrganizationSummary? organization;
    private WorkspaceDetail? workspace;
    private WorkspaceProjectSummary? container;
    private IReadOnlyList<ModelPresence> presence = [];
    private readonly CancellationTokenSource lifetime = new();
    private Task? presenceTask;
    private string moveFolder = "";
    private bool allowNavigation;
    private bool isSwitchingModel;
    private bool showFiles, showCollaboration, showMove, confirmDelete, hasUnsavedChanges, disposed;
    private bool CanEdit => model?.CanEdit == true;
    private string ContainerHref => model?.WorkspaceId is { } workspaceId && model.WorkspaceProjectId is { } projectId
        ? $"/workspaces/{workspaceId}/projects/{projectId}" : "/workspaces";
    private bool isSaving;
    private bool isImporting;
    private bool hasPendingAutosave;
    private string? statusMessage;
    private string? editorReadWarning;
    private string? autosaveError;
    private string? selectedSampleId;
    private ProjectSample? pendingSample;
    private bool isFullScreen;
    private int editorRevision;
    private Guid? loadedProjectId;
    private string? loadedSampleId;
    private DateTimeOffset? lastAutosavedUtc;
    private CancellationTokenSource? autosaveDelayCts;

    private string DraftName => string.IsNullOrWhiteSpace(form.Name) ? "New project" : form.Name;

    private string Title => ProjectId.HasValue ? form.Name : "New project";

    private string ModeLabel => ProjectId.HasValue ? "Edit project" : "Create project";

    private string ImportLabel => isImporting ? "Importing..." : "Import";

    private string AutoSaveText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(autosaveError))
            {
                return "Not saved";
            }

            if (isSaving)
            {
                return "Autosaving...";
            }

            if (hasUnsavedChanges) return "Unsaved changes";

            if (lastAutosavedUtc is { } savedUtc)
            {
                return $"Saved {savedUtc.ToLocalTime():HH:mm:ss}";
            }

            return ProjectId.HasValue ? "Autosave ready" : "Create a project to start autosave";
        }
    }

    private string AutoSaveIndicatorClass =>
        !string.IsNullOrWhiteSpace(autosaveError)
            ? "autosave-indicator has-error"
            : isSaving
                ? "autosave-indicator is-saving"
                : "autosave-indicator is-saved";

    private string HelpText => ProjectId.HasValue
        ? "Changes are saved automatically while you work."
        : "Create a project to save it immediately in this tenant workspace, then model its structure.";

    private string EditorPanelClass =>
        isFullScreen ? "editor-panel is-fullscreen" : "editor-panel";

    private string GetProjectRowClass(Guid projectId) =>
        ProjectId == projectId ? "project-row active" : "project-row";

    private static string GetProjectHref(Guid projectId) => $"/projects/{projectId}";

    protected override async Task OnParametersSetAsync()
    {
        if (!ProjectId.HasValue && string.IsNullOrWhiteSpace(SampleId))
        {
            NavigationManager.NavigateTo("/workspaces");
            return;
        }

        await WorkspaceService.GetWorkspacesAsync();
        organization ??= await WorkspaceService.GetOrganizationAsync();
        projects = await ProjectService.GetProjectsAsync();

        if (!ProjectId.HasValue
            && string.IsNullOrWhiteSpace(SampleId)
            && projects.Count > 0)
        {
            NavigateWithFreshEditor(GetProjectHref(projects[0].Id));
            return;
        }

        if (ProjectId is { } id)
        {
            var project = await ProjectService.GetProjectAsync(id);
            if (project is null)
            {
                NavigationManager.NavigateTo("/workspaces");
                return;
            }

            model = project;
            workspace = project.WorkspaceId is { } workspaceId ? await WorkspaceService.GetWorkspaceAsync(workspaceId) : null;
            container = workspace?.Projects.SingleOrDefault(p => p.Id == project.WorkspaceProjectId);
            form.FolderPath = project.FolderPath;

            form.Name = project.Name;
            form.BpmnXml = GetValidBpmnXmlOrDefault(project.BpmnXml);
            form.LogicXml = project.LogicXml ?? "";
            form.LogicTargetElementId = null;

            if (loadedProjectId != id)
            {
                loadedProjectId = id;
                loadedSampleId = null;
                statusMessage = null;
                autosaveError = null;
                lastAutosavedUtc = project.UpdatedUtc;
                selectedSampleId = null;
                editorRevision++;
            }
        }
        else if (!string.IsNullOrWhiteSpace(SampleId))
        {
            if (!string.Equals(loadedSampleId, SampleId, StringComparison.OrdinalIgnoreCase))
            {
                var sample = ProjectSamples.Find(SampleId);
                if (sample is not null)
                {
                    LoadSampleDraft(sample);
                    await AutosaveNowAsync(GetSampleSavedMessage(sample), readEditor: false);
                    return;
                }
                else if (string.IsNullOrWhiteSpace(form.BpmnXml))
                {
                    PrepareNewProject();
                    statusMessage = "The selected demo sample was not found.";
                }

                loadedSampleId = SampleId;
            }
        }
        else if (string.IsNullOrWhiteSpace(form.BpmnXml))
        {
            PrepareNewProject();
        }
        else
        {
            loadedProjectId = null;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (presenceTask is null && ProjectId.HasValue)
            presenceTask = RunPresenceAsync();
        return Task.CompletedTask;
    }

    private async Task RunPresenceAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(25));
        try
        {
            do
            {
                await InvokeAsync(async () =>
                {
                    if (!isSaving && !isImporting && ProjectId is { } id)
                    {
                        try
                        {
                            presence = await ProjectService.HeartbeatAsync(id);
                            var current = await ProjectService.GetProjectAsync(id);
                            if (model is not null && current is not null)
                                model = model with { CanEdit = current.CanEdit, CanManage = current.CanManage };
                        }
                        catch (InvalidOperationException)
                        {
                            if (model is not null) model = model with { CanEdit = false, CanManage = false };
                            statusMessage = "Workspace access has changed. You can save a local copy of your open model.";
                        }
                        StateHasChanged();
                    }
                });
            } while (await timer.WaitForNextTickAsync(lifetime.Token));
        }
        catch (OperationCanceledException) { }
        catch (Exception) { /* Presence is advisory; model saves enforce permissions independently. */ }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (allowNavigation) { allowNavigation = false; return; }
        if (CanEdit) await AutosaveNowAsync(readEditor: true);
        if (hasUnsavedChanges || isSaving || !string.IsNullOrEmpty(autosaveError)) context.PreventNavigation();
    }

    private async Task SelectModelAsync(Guid id)
    {
        if (CanEdit) await AutosaveNowAsync(readEditor: true);
        if (!hasUnsavedChanges) NavigateWithFreshEditor(GetProjectHref(id));
    }

    private async Task ToggleCollaborationAsync()
    {
        if (!showCollaboration && CanEdit) await AutosaveNowAsync(readEditor: true);
        if (hasUnsavedChanges) return;
        if (workspace is not null) workspace = await WorkspaceService.GetWorkspaceAsync(workspace.Id);
        showCollaboration = !showCollaboration;
    }

    private async Task ReloadModelAsync()
    {
        if (ProjectId is not { } id) return;
        if (hasUnsavedChanges) { statusMessage = "Save or export your pending edits before reloading."; return; }
        var previousRevision = model?.Revision;
        var changeVersion = await JSRuntime.InvokeAsync<long>("simpleXflowEditor.getChangeVersion", "simplexflow-editor");
        var refreshed = await ProjectService.GetProjectAsync(id);
        if (ProjectId != id || previousRevision != model?.Revision || hasUnsavedChanges
            || changeVersion != await JSRuntime.InvokeAsync<long>("simpleXflowEditor.getChangeVersion", "simplexflow-editor")
            || await JSRuntime.InvokeAsync<bool>("simpleXflowEditor.isDirty", "simplexflow-editor"))
        {
            statusMessage = "Your local edits were kept. Save them before reloading the model.";
            return;
        }
        model = refreshed;
        if (model is null) { NavigationManager.NavigateTo("/workspaces"); return; }
        form.Name = model.Name;
        form.BpmnXml = model.BpmnXml;
        form.LogicXml = model.LogicXml;
        form.FolderPath = model.FolderPath;
        autosaveError = null;
        if (previousRevision != model.Revision) editorRevision++;
        if (workspace is not null) workspace = await WorkspaceService.GetWorkspaceAsync(workspace.Id);
    }

    private async Task RequestReload() => await JSRuntime.InvokeVoidAsync("simpleXflowFiles.reload");

    private async Task<bool> PrepareCollaborationAsync()
    {
        if (CanEdit) await AutosaveNowAsync(readEditor: true);
        return !hasUnsavedChanges && !isSaving;
    }

    private void OpenMove() { moveFolder = form.FolderPath; showMove = true; }
    private Task CancelMove()
    {
        form.FolderPath = model?.FolderPath ?? "";
        showMove = false;
        return ScheduleAutosaveAsync();
    }

    private async Task MoveAsync()
    {
        form.FolderPath = string.Join('/', moveFolder.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        hasUnsavedChanges = true;
        await AutosaveNowAsync();
        if (string.IsNullOrEmpty(autosaveError)) showMove = false;
    }

    private async Task DeleteAsync()
    {
        if (model is null || isSaving) return;
        isSaving = true;
        autosaveDelayCts?.Cancel();
        try
        {
            await ProjectService.DeleteProjectAsync(model.Id, model.Revision);
            var changeVersion = await JSRuntime.InvokeAsync<long>("simpleXflowEditor.getChangeVersion", "simplexflow-editor");
            await JSRuntime.InvokeAsync<bool>("simpleXflowEditor.clearDirty", "simplexflow-editor", changeVersion);
            hasUnsavedChanges = false;
            NavigateWithFreshEditor(ContainerHref);
        }
        catch (Exception ex) { statusMessage = ex.Message; confirmDelete = false; }
        finally { isSaving = false; }
    }

    private void PrepareNewProject()
    {
        statusMessage = null;
        form.Name = "New project";
        form.BpmnXml = DefaultBpmnXml;
        form.LogicXml = "";
        form.LogicTargetElementId = null;
        autosaveError = null;
        lastAutosavedUtc = null;
        loadedProjectId = null;
        loadedSampleId = null;
        editorRevision++;
    }

    private async Task StartNewProjectAsync()
    {
        if (isSaving || isImporting || !CanEdit)
        {
            return;
        }

        await AutosaveNowAsync(readEditor: true);
        if (hasUnsavedChanges || !string.IsNullOrEmpty(autosaveError)) return;

        pendingSample = null;
        isSwitchingModel = true;
        isSaving = true;
        statusMessage = "Creating saved simpleXflow project...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var createdProjectId = await ProjectService.CreateProjectAsync(
                new CreateProjectRequest("New model", DefaultBpmnXml, WorkspaceProjectId: model?.WorkspaceProjectId, FolderPath: form.FolderPath));

            NavigateWithFreshEditor($"/projects/{createdProjectId}");
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
            isSwitchingModel = false;
        }
    }

    private Task RequestSampleLoadAsync()
    {
        var sample = ProjectSamples.Find(selectedSampleId);
        if (sample is null)
        {
            statusMessage = "Select a demo sample first.";
            return Task.CompletedTask;
        }

        pendingSample = sample;
        statusMessage = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmSampleLoadAsync()
    {
        var sample = pendingSample;
        pendingSample = null;

        if (sample is null)
        {
            return;
        }

        if (CanEdit)
        {
            await AutosaveNowAsync(readEditor: true);
            if (hasUnsavedChanges || !string.IsNullOrEmpty(autosaveError)) return;
        }
        hasUnsavedChanges = true;
        LoadSampleDraft(sample, ProjectId.HasValue);
        await AutosaveNowAsync(GetSampleSavedMessage(sample), readEditor: false);
    }

    private void CancelSampleLoad()
    {
        pendingSample = null;
    }

    private void ToggleFullScreen()
    {
        isFullScreen = !isFullScreen;
    }

    private void LoadSampleDraft(ProjectSample sample, bool keepCurrentProject = false)
    {
        pendingSample = null;
        form.Name = sample.Name;
        form.BpmnXml = sample.BpmnXml;
        form.LogicXml = sample.LogicXml ?? "";
        form.LogicTargetElementId = sample.LogicTargetElementId;
        selectedSampleId = sample.Id;
        loadedProjectId = keepCurrentProject ? ProjectId : null;
        loadedSampleId = sample.Id;
        autosaveError = null;
        editorRevision++;
        statusMessage = string.IsNullOrWhiteSpace(form.LogicXml)
            ? $"{sample.Name} loaded. Autosave is updating the project."
            : $"{sample.Name} loaded with architecture and Room1 logic. Autosave is updating the project.";
    }

    private static string GetSampleSavedMessage(ProjectSample sample) =>
        string.IsNullOrWhiteSpace(sample.LogicXml)
            ? $"{sample.Name} loaded and saved."
            : $"{sample.Name} loaded and saved with architecture and Room1 logic.";

    private async Task OnNameChangedAsync(ChangeEventArgs args)
    {
        form.Name = args.Value?.ToString() ?? "";
        await ScheduleAutosaveAsync();
    }

    private Task OnEditorModelChangedAsync(SimpleXflowModeler.EditorModelChange change)
    {
        if (!string.IsNullOrWhiteSpace(change.BpmnXml))
        {
            form.BpmnXml = GetValidBpmnXmlOrDefault(change.BpmnXml);
        }

        if (change.LogicXml is not null)
        {
            form.LogicXml = change.LogicXml;
        }

        return ScheduleAutosaveAsync();
    }

    private Task OnEditorDirtyAsync(long version) => ScheduleAutosaveAsync();

    private Task ScheduleAutosaveAsync()
    {
        if (!CanEdit || disposed)
        {
            return Task.CompletedTask;
        }

        hasUnsavedChanges = true;
        if (isImporting) return InvokeAsync(StateHasChanged);
        autosaveError = null;
        autosaveDelayCts?.Cancel();
        autosaveDelayCts?.Dispose();

        var delayCts = new CancellationTokenSource();
        autosaveDelayCts = delayCts;
        _ = AutosaveAfterDelayAsync(delayCts);

        return InvokeAsync(StateHasChanged);
    }

    private async Task AutosaveAfterDelayAsync(CancellationTokenSource delayCts)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, delayCts.Token);
            await InvokeAsync(() => AutosaveNowAsync());
        }
        catch (OperationCanceledException)
        {
            // A newer change superseded this autosave run.
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                autosaveError = $"Autosave failed: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private async Task AutosaveNowAsync(string? successMessage = null, bool readEditor = true)
    {
        if (isImporting || disposed || (ProjectId.HasValue && !CanEdit))
        {
            return;
        }

        if (isSaving)
        {
            hasPendingAutosave = true;
            return;
        }

        isSaving = true;
        autosaveError = null;
        editorReadWarning = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            ValidateForm();
            if (readEditor && ProjectId.HasValue && !hasUnsavedChanges
                && !await JSRuntime.InvokeAsync<bool>("simpleXflowEditor.isDirty", "simplexflow-editor")) return;
            var changeVersion = readEditor && ProjectId.HasValue
                ? await JSRuntime.InvokeAsync<long>("simpleXflowEditor.getChangeVersion", "simplexflow-editor") : 0;

            if (readEditor)
            {
                form.BpmnXml = await ReadEditorXmlAsync();
                form.LogicXml = await ReadEditorLogicAsync();
            }

            if (ProjectId is { } id)
            {
                var savedName = form.Name;
                var savedXml = form.BpmnXml;
                var savedLogic = form.LogicXml;
                var savedFolder = form.FolderPath;
                var revision = await ProjectService.UpdateProjectAsync(id, new UpdateProjectRequest(savedName, savedXml, savedLogic, model?.Revision, savedFolder));
                if (model is not null) model = model with { Revision = revision, Name = savedName, BpmnXml = savedXml, LogicXml = savedLogic, FolderPath = savedFolder };
                var editorSaved = !readEditor || await JSRuntime.InvokeAsync<bool>("simpleXflowEditor.clearDirty", "simplexflow-editor", changeVersion);
                hasUnsavedChanges = !editorSaved || form.Name != savedName || form.FolderPath != savedFolder;
                if (hasUnsavedChanges) hasPendingAutosave = true;
                projects = await ProjectService.GetProjectsAsync();
                lastAutosavedUtc = DateTimeOffset.UtcNow;
                statusMessage = editorReadWarning ?? successMessage;
            }
            else
            {
                var createdProjectId = await ProjectService.CreateProjectAsync(new CreateProjectRequest(form.Name, form.BpmnXml, form.LogicXml));
                hasUnsavedChanges = false;
                lastAutosavedUtc = DateTimeOffset.UtcNow;
                statusMessage = editorReadWarning ?? successMessage;
                NavigateWithFreshEditor($"/projects/{createdProjectId}");
                return;
            }
        }
        catch (Exception ex)
        {
            hasUnsavedChanges = true;
            autosaveError = $"Autosave failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }

        await InvokeAsync(StateHasChanged);

        if (hasPendingAutosave)
        {
            hasPendingAutosave = false;
            await ScheduleAutosaveAsync();
        }
    }

    private async Task<string> ReadEditorXmlAsync()
    {
        using var timeout = new CancellationTokenSource(EditorReadTimeout);
        var xml = await JSRuntime.InvokeAsync<string>("simpleXflowEditor.getXml", timeout.Token);
        return !string.IsNullOrWhiteSpace(xml) ? xml : throw new InvalidOperationException("The editor has not returned the current model. Keep this page open and try again.");
    }

    private async Task<string?> ReadEditorLogicAsync()
    {
        using var timeout = new CancellationTokenSource(EditorReadTimeout);
        return await JSRuntime.InvokeAsync<string?>("simpleXflowEditor.getLogic", timeout.Token);
    }

    private void ValidateForm()
    {
        var validationResults = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        var validationContext = new System.ComponentModel.DataAnnotations.ValidationContext(form);

        if (!System.ComponentModel.DataAnnotations.Validator.TryValidateObject(form, validationContext, validationResults, true))
        {
            var message = validationResults.FirstOrDefault()?.ErrorMessage ?? "Please check the project details.";
            throw new InvalidOperationException(message);
        }
    }

    private async Task ImportProjectAsync(InputFileChangeEventArgs args)
    {
        if (!CanEdit || isSaving || isImporting) return;
        var sourceModelId = ProjectId;
        var targetProjectId = model?.WorkspaceProjectId;
        var targetFolder = form.FolderPath;
        await AutosaveNowAsync(readEditor: true);
        if (hasUnsavedChanges || !string.IsNullOrEmpty(autosaveError)) return;
        isImporting = true;
        statusMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await using var upload = args.File.OpenReadStream(ProjectFileImporter.MaxFileBytes);
            var importedProject = await ProjectFileImporter.ReadAsync(upload, args.File.Name);
            var createdProjectId = await ProjectService.CreateProjectAsync(
                new CreateProjectRequest(importedProject.Name, importedProject.BpmnXml, importedProject.LogicXml, targetProjectId, targetFolder));

            if (disposed || ProjectId != sourceModelId) return;

            projects = await ProjectService.GetProjectsAsync();
            statusMessage = $"Imported {importedProject.Name}.";
            isImporting = false;
            if (hasUnsavedChanges) await AutosaveNowAsync();
            if (hasUnsavedChanges) return;
            NavigateWithFreshEditor($"/projects/{createdProjectId}");
        }
        catch (Exception ex)
        {
            statusMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private static string GetValidBpmnXmlOrDefault(string? xml)
    {
        return string.IsNullOrWhiteSpace(xml) ? DefaultBpmnXml.Trim() : xml.Trim();
    }

    private void NavigateWithFreshEditor(string uri)
    {
        allowNavigation = true;
        NavigationManager.NavigateTo(uri, forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await lifetime.CancelAsync();
        autosaveDelayCts?.Cancel();
        autosaveDelayCts?.Dispose();
        if (presenceTask is not null) await presenceTask;
        if (presenceTask is not null && ProjectId is { } id)
        {
            try { await ProjectService.LeaveModelAsync(id); }
            catch (Exception) { /* Presence expires after a disconnected circuit. */ }
        }
        lifetime.Dispose();
    }

    private sealed class ProjectForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Project name is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(240, MinimumLength = 1, ErrorMessage = "Use between 1 and 240 characters for the model name.")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string BpmnXml { get; set; } = "";

        public string? LogicXml { get; set; }

        public string? LogicTargetElementId { get; set; }

        public string FolderPath { get; set; } = "";
    }

