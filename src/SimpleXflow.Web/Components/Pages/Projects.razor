@page "/projects"
@page "/projects/{ProjectId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using System.IO.Compression
@using SimpleXflow.Application.Projects

@implements IDisposable

@inject IFlowProjectService ProjectService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Projects</PageTitle>

<section class="workspace-shell">
    <aside class="project-list">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">Tenant workspace</span>
                <h1>Projects</h1>
            </div>
            <button type="button" class="icon-button" title="New simpleXflow project" @onclick="StartNewProjectAsync">+</button>
        </div>

        @if (projects.Count == 0 && ProjectId.HasValue)
        {
            <div class="empty-state project-empty-state">
                <strong>No simpleXflow projects yet</strong>
                <span>Create your first simpleXflow project or import an existing project.</span>
                <button type="button" class="secondary-action" @onclick="StartNewProjectAsync">Create first project</button>
            </div>
        }
        else
        {
            <nav class="project-nav" aria-label="simpleXflow projects">
                @if (!ProjectId.HasValue)
                {
                    <button type="button" class="project-row active draft" @onclick="StartNewProjectAsync">
                        <span>@DraftName</span>
                        <small>Click to create</small>
                    </button>
                }

                @foreach (var project in projects)
                {
                    <a class="@GetProjectRowClass(project.Id)" href="@GetProjectHref(project.Id)" data-enhance-nav="false">
                        <span>@project.Name</span>
                        <small>@project.UpdatedUtc.ToLocalTime().ToString("g")</small>
                    </a>
                }
            </nav>

            @if (projects.Count == 0)
            {
                <div class="empty-state project-empty-state">
                    <strong>No saved projects yet</strong>
                    <span>Create the first project. It is saved immediately and can be edited afterwards.</span>
                </div>
            }
        }
    </aside>

    <section class="@EditorPanelClass">
        @if (isFullScreen)
        {
            <div class="fullscreen-action-bar">
                <span>@form.Name</span>
                <span class="@AutoSaveIndicatorClass">@AutoSaveText</span>
                <button type="button" class="secondary-action" @onclick="ToggleFullScreen">Exit full screen</button>
            </div>
        }
        else
        {
            <div class="editor-toolbar">
                <div>
                    <span class="eyebrow">@ModeLabel</span>
                    <h2>@Title</h2>
                    <p class="toolbar-help">@HelpText</p>
                </div>
                <div class="toolbar-actions">
                    <div class="sample-action">
                        <select class="sample-select" @bind="selectedSampleId" aria-label="Demo sample">
                            <option value="">Demo sample</option>
                            @foreach (var sample in ProjectSamples.All)
                            {
                                <option value="@sample.Id">@sample.Name</option>
                            }
                        </select>
                        <button type="button" class="secondary-action" @onclick="RequestSampleLoadAsync" disabled="@string.IsNullOrWhiteSpace(selectedSampleId)">Load</button>
                    </div>
                    <div class="@AutoSaveIndicatorClass" aria-live="polite">@AutoSaveText</div>
                    <button type="button" class="secondary-action" @onclick="ToggleFullScreen">Full screen</button>
                    <label class="secondary-action import-action" title="Import simpleXflow project">
                        @ImportLabel
                        <InputFile id="project-import-file" OnChange="ImportProjectAsync" accept=".bpmn,.xml,.zip" class="import-file-input" />
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="status-line">@statusMessage</div>
            }

            <EditForm Model="form" class="editor-form project-meta-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <label>
                    Name
                    <input type="text" value="@form.Name" @oninput="OnNameChangedAsync" class="form-control" />
                </label>

            </EditForm>

            <div class="workflow-hint" role="status">
                <div>
                    <strong>1. Model</strong>
                    <span>Use the palette to model the architecture of the simpleXflow project.</span>
                </div>
                <div>
                    <strong>2. Configure</strong>
                    <span>Select an element to edit properties, requirements and validations.</span>
                </div>
                <div>
                    <strong>3. Autosave</strong>
                    <span>Every valid change is saved automatically to the tenant workspace.</span>
                </div>
            </div>
        }

        <SimpleXflowModeler ProjectName="@form.Name" Xml="@form.BpmnXml" LogicXml="@form.LogicXml" LogicTargetElementId="@form.LogicTargetElementId" Revision="@editorRevision" IsFullScreen="@isFullScreen" OnModelChanged="OnEditorModelChangedAsync" />
    </section>
</section>

@if (pendingSample is not null)
{
    <div class="confirmation-backdrop" role="presentation">
        <div class="confirmation-dialog" role="alertdialog" aria-modal="true" aria-labelledby="replace-sample-title">
            <span class="eyebrow">Load demo sample</span>
            <h2 id="replace-sample-title">Replace current model?</h2>
            <p>
                Loading <strong>@pendingSample.Name</strong> replaces the model currently shown in the editor.
                The replacement is saved automatically after you confirm.
            </p>
            <div class="confirmation-actions">
                <button type="button" class="secondary-action" @onclick="CancelSampleLoad">Cancel</button>
                <button type="button" class="primary-action" @onclick="ConfirmSampleLoadAsync">Replace model</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "sample")]
    public string? SampleId { get; set; }

    private readonly ProjectForm form = new();
    private const int AutosaveDelayMilliseconds = 1200;
    private IReadOnlyList<ProjectSummary> projects = [];
    private bool isSaving;
    private bool isImporting;
    private bool hasPendingAutosave;
    private string? statusMessage;
    private string? editorReadWarning;
    private string? autosaveError;
    private string? selectedSampleId;
    private ProjectSample? pendingSample;
    private bool isFullScreen;
    private int editorRevision;
    private Guid? loadedProjectId;
    private string? loadedSampleId;
    private DateTimeOffset? lastAutosavedUtc;
    private CancellationTokenSource? autosaveDelayCts;

    private string DraftName => string.IsNullOrWhiteSpace(form.Name) ? "New project" : form.Name;

    private string Title => ProjectId.HasValue ? form.Name : "New project";

    private string ModeLabel => ProjectId.HasValue ? "Edit project" : "Create project";

    private string ImportLabel => isImporting ? "Importing..." : "Import";

    private string AutoSaveText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(autosaveError))
            {
                return autosaveError;
            }

            if (isSaving)
            {
                return "Autosaving...";
            }

            if (lastAutosavedUtc is { } savedUtc)
            {
                return $"Saved {savedUtc.ToLocalTime():HH:mm:ss}";
            }

            return ProjectId.HasValue ? "Autosave ready" : "Create a project to start autosave";
        }
    }

    private string AutoSaveIndicatorClass =>
        !string.IsNullOrWhiteSpace(autosaveError)
            ? "autosave-indicator has-error"
            : isSaving
                ? "autosave-indicator is-saving"
                : "autosave-indicator is-saved";

    private string HelpText => ProjectId.HasValue
        ? "Changes are saved automatically. Use the editor's Ctrl+Z while modeling to reverse the last local diagram action."
        : "Create a project to save it immediately in this tenant workspace, then model its structure.";

    private string EditorPanelClass =>
        isFullScreen ? "editor-panel is-fullscreen" : "editor-panel";

    private string GetProjectRowClass(Guid projectId) =>
        ProjectId == projectId ? "project-row active" : "project-row";

    private static string GetProjectHref(Guid projectId) => $"/projects/{projectId}";

    protected override async Task OnParametersSetAsync()
    {
        projects = await ProjectService.GetProjectsAsync();

        if (!ProjectId.HasValue
            && string.IsNullOrWhiteSpace(SampleId)
            && projects.Count > 0)
        {
            NavigateWithFreshEditor(GetProjectHref(projects[0].Id));
            return;
        }

        if (ProjectId is { } id)
        {
            var project = await ProjectService.GetProjectAsync(id);
            if (project is null)
            {
                NavigationManager.NavigateTo("/projects");
                return;
            }

            form.Name = project.Name;
            form.BpmnXml = GetValidBpmnXmlOrDefault(project.BpmnXml);
            form.LogicXml = project.LogicXml ?? "";
            form.LogicTargetElementId = null;

            if (loadedProjectId != id)
            {
                loadedProjectId = id;
                loadedSampleId = null;
                statusMessage = null;
                autosaveError = null;
                lastAutosavedUtc = project.UpdatedUtc;
                selectedSampleId = null;
                editorRevision++;
            }
        }
        else if (!string.IsNullOrWhiteSpace(SampleId))
        {
            if (!string.Equals(loadedSampleId, SampleId, StringComparison.OrdinalIgnoreCase))
            {
                var sample = ProjectSamples.Find(SampleId);
                if (sample is not null)
                {
                    LoadSampleDraft(sample);
                    await AutosaveNowAsync(GetSampleSavedMessage(sample), readEditor: false);
                    return;
                }
                else if (string.IsNullOrWhiteSpace(form.BpmnXml))
                {
                    PrepareNewProject();
                    statusMessage = "The selected demo sample was not found.";
                }

                loadedSampleId = SampleId;
            }
        }
        else if (string.IsNullOrWhiteSpace(form.BpmnXml))
        {
            PrepareNewProject();
        }
        else
        {
            loadedProjectId = null;
        }
    }

    private void PrepareNewProject()
    {
        statusMessage = null;
        form.Name = "New project";
        form.BpmnXml = DefaultBpmnXml;
        form.LogicXml = "";
        form.LogicTargetElementId = null;
        autosaveError = null;
        lastAutosavedUtc = null;
        loadedProjectId = null;
        loadedSampleId = null;
        editorRevision++;
    }

    private async Task StartNewProjectAsync()
    {
        if (isSaving || isImporting)
        {
            return;
        }

        pendingSample = null;
        isSaving = true;
        statusMessage = "Creating saved simpleXflow project...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var createdProjectId = await ProjectService.CreateProjectAsync(
                new CreateProjectRequest("New project", DefaultBpmnXml));

            NavigateWithFreshEditor($"/projects/{createdProjectId}");
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task RequestSampleLoadAsync()
    {
        var sample = ProjectSamples.Find(selectedSampleId);
        if (sample is null)
        {
            statusMessage = "Select a demo sample first.";
            return Task.CompletedTask;
        }

        pendingSample = sample;
        statusMessage = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmSampleLoadAsync()
    {
        var sample = pendingSample;
        pendingSample = null;

        if (sample is null)
        {
            return;
        }

        LoadSampleDraft(sample, ProjectId.HasValue);
        await AutosaveNowAsync(GetSampleSavedMessage(sample), readEditor: false);
    }

    private void CancelSampleLoad()
    {
        pendingSample = null;
    }

    private void ToggleFullScreen()
    {
        isFullScreen = !isFullScreen;
    }

    private void LoadSampleDraft(ProjectSample sample, bool keepCurrentProject = false)
    {
        pendingSample = null;
        form.Name = sample.Name;
        form.BpmnXml = sample.BpmnXml;
        form.LogicXml = sample.LogicXml ?? "";
        form.LogicTargetElementId = sample.LogicTargetElementId;
        selectedSampleId = sample.Id;
        loadedProjectId = keepCurrentProject ? ProjectId : null;
        loadedSampleId = sample.Id;
        autosaveError = null;
        editorRevision++;
        statusMessage = string.IsNullOrWhiteSpace(form.LogicXml)
            ? $"{sample.Name} loaded. Autosave is updating the project."
            : $"{sample.Name} loaded with architecture and Room1 logic. Autosave is updating the project.";
    }

    private static string GetSampleSavedMessage(ProjectSample sample) =>
        string.IsNullOrWhiteSpace(sample.LogicXml)
            ? $"{sample.Name} loaded and saved."
            : $"{sample.Name} loaded and saved with architecture and Room1 logic.";

    private async Task OnNameChangedAsync(ChangeEventArgs args)
    {
        form.Name = args.Value?.ToString() ?? "";
        await ScheduleAutosaveAsync();
    }

    private Task OnEditorModelChangedAsync()
    {
        return ScheduleAutosaveAsync();
    }

    private Task ScheduleAutosaveAsync()
    {
        if (isImporting)
        {
            return Task.CompletedTask;
        }

        autosaveError = null;
        autosaveDelayCts?.Cancel();
        autosaveDelayCts?.Dispose();

        var delayCts = new CancellationTokenSource();
        autosaveDelayCts = delayCts;
        _ = AutosaveAfterDelayAsync(delayCts);

        return InvokeAsync(StateHasChanged);
    }

    private async Task AutosaveAfterDelayAsync(CancellationTokenSource delayCts)
    {
        try
        {
            await Task.Delay(AutosaveDelayMilliseconds, delayCts.Token);
            await InvokeAsync(() => AutosaveNowAsync());
        }
        catch (OperationCanceledException)
        {
            // A newer change superseded this autosave run.
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                autosaveError = $"Autosave failed: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private async Task AutosaveNowAsync(string? successMessage = null, bool readEditor = true)
    {
        if (isImporting)
        {
            return;
        }

        if (isSaving)
        {
            hasPendingAutosave = true;
            return;
        }

        isSaving = true;
        autosaveError = null;
        editorReadWarning = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            ValidateForm();

            if (readEditor)
            {
                form.BpmnXml = await GetEditorXmlOrFallbackAsync();
                form.LogicXml = await GetEditorLogicOrFallbackAsync();
            }

            if (ProjectId is { } id)
            {
                await ProjectService.UpdateProjectAsync(id, new UpdateProjectRequest(form.Name, form.BpmnXml, form.LogicXml));
                projects = await ProjectService.GetProjectsAsync();
                lastAutosavedUtc = DateTimeOffset.UtcNow;
                statusMessage = editorReadWarning ?? successMessage;
            }
            else
            {
                var createdProjectId = await ProjectService.CreateProjectAsync(new CreateProjectRequest(form.Name, form.BpmnXml, form.LogicXml));
                lastAutosavedUtc = DateTimeOffset.UtcNow;
                statusMessage = editorReadWarning ?? successMessage;
                NavigateWithFreshEditor($"/projects/{createdProjectId}");
                return;
            }
        }
        catch (Exception ex)
        {
            autosaveError = $"Autosave failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }

        if (hasPendingAutosave)
        {
            hasPendingAutosave = false;
            await ScheduleAutosaveAsync();
        }
    }

    private async Task<string> GetEditorXmlOrFallbackAsync()
    {
        try
        {
            var editorXml = await JSRuntime.InvokeAsync<string>("simpleXflowEditor.getXml");
            if (!string.IsNullOrWhiteSpace(editorXml))
            {
                return editorXml;
            }
        }
        catch (Exception ex)
        {
            editorReadWarning = $"Saved using the last known simpleXflow model because the visual editor did not return XML. Details: {ex.Message}";
        }

        return GetValidBpmnXmlOrDefault(form.BpmnXml);
    }

    private async Task<string?> GetEditorLogicOrFallbackAsync()
    {
        try
        {
            var editorLogicXml = await JSRuntime.InvokeAsync<string?>("simpleXflowEditor.getLogic");
            if (!string.IsNullOrWhiteSpace(editorLogicXml))
            {
                return editorLogicXml;
            }
        }
        catch
        {
            // Logic export is best-effort because the legacy editor stores it separately from the architecture XML.
        }

        return form.LogicXml;
    }

    private void ValidateForm()
    {
        var validationResults = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
        var validationContext = new System.ComponentModel.DataAnnotations.ValidationContext(form);

        if (!System.ComponentModel.DataAnnotations.Validator.TryValidateObject(form, validationContext, validationResults, true))
        {
            var message = validationResults.FirstOrDefault()?.ErrorMessage ?? "Please check the project details.";
            throw new InvalidOperationException(message);
        }
    }

    private async Task ImportProjectAsync(InputFileChangeEventArgs args)
    {
        isImporting = true;
        statusMessage = null;

        try
        {
            var importedProject = await ReadImportedProjectAsync(args.File);
            var createdProjectId = await ProjectService.CreateProjectAsync(
                new CreateProjectRequest(importedProject.Name, importedProject.BpmnXml, importedProject.LogicXml));

            projects = await ProjectService.GetProjectsAsync();
            statusMessage = $"Imported {importedProject.Name}.";
            NavigateWithFreshEditor($"/projects/{createdProjectId}");
        }
        catch (Exception ex)
        {
            statusMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private static async Task<ImportedProject> ReadImportedProjectAsync(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);

        if (extension.Equals(".zip", StringComparison.OrdinalIgnoreCase))
        {
            return await ReadZipProjectAsync(file);
        }

        if (!extension.Equals(".bpmn", StringComparison.OrdinalIgnoreCase)
            && !extension.Equals(".xml", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("Only simpleXflow project files with .bpmn, .xml or .zip can be imported.");
        }

        await using var stream = file.OpenReadStream(MaxImportFileBytes);
        using var reader = new StreamReader(stream);
        var xml = await reader.ReadToEndAsync();
        EnsureBpmnXml(xml);

        return new ImportedProject(GetProjectName(file.Name), xml, null);
    }

    private static async Task<ImportedProject> ReadZipProjectAsync(IBrowserFile file)
    {
        await using var uploadStream = file.OpenReadStream(MaxImportFileBytes);
        using var archiveStream = new MemoryStream();
        await uploadStream.CopyToAsync(archiveStream);
        archiveStream.Position = 0;

        using var archive = new ZipArchive(archiveStream, ZipArchiveMode.Read);
        var bpmnEntry = archive.Entries
            .Where(entry => !string.IsNullOrWhiteSpace(entry.Name)
                && Path.GetExtension(entry.Name).Equals(".bpmn", StringComparison.OrdinalIgnoreCase))
            .OrderBy(entry => entry.FullName.Count(character => character is '/' or '\\'))
            .ThenBy(entry => entry.FullName.Length)
            .FirstOrDefault()
            ?? throw new InvalidOperationException("The zip file does not contain a simpleXflow project file.");

        using var entryStream = bpmnEntry.Open();
        using var reader = new StreamReader(entryStream);
        var xml = await reader.ReadToEndAsync();
        EnsureBpmnXml(xml);

        var projectName = string.IsNullOrWhiteSpace(Path.GetFileNameWithoutExtension(bpmnEntry.Name))
            ? GetProjectName(file.Name)
            : GetProjectName(bpmnEntry.Name);

        return new ImportedProject(projectName, xml, null);
    }

    private static void EnsureBpmnXml(string xml)
    {
        if (string.IsNullOrWhiteSpace(xml)
            || (!xml.Contains("<bpmn", StringComparison.OrdinalIgnoreCase)
                && !xml.Contains(":definitions", StringComparison.OrdinalIgnoreCase)
                && !xml.Contains("<definitions", StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException("The selected file is not a simpleXflow project file.");
        }
    }

    private static string GetProjectName(string fileName)
    {
        var name = Path.GetFileNameWithoutExtension(fileName).Trim();
        return string.IsNullOrWhiteSpace(name) ? "Imported project" : name;
    }

    private static string GetValidBpmnXmlOrDefault(string? xml)
    {
        return string.IsNullOrWhiteSpace(xml) ? DefaultBpmnXml.Trim() : xml.Trim();
    }

    private void NavigateWithFreshEditor(string uri)
    {
        NavigationManager.NavigateTo(uri, forceLoad: true);
    }

    public void Dispose()
    {
        autosaveDelayCts?.Cancel();
        autosaveDelayCts?.Dispose();
    }

    private sealed class ProjectForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Project name is required.")]
        [System.ComponentModel.DataAnnotations.StringLength(240, MinimumLength = 2, ErrorMessage = "Use at least 2 characters for the project name.")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string BpmnXml { get; set; } = "";

        public string? LogicXml { get; set; }

        public string? LogicTargetElementId { get; set; }
    }

    private sealed record ImportedProject(string Name, string BpmnXml, string? LogicXml);

    private const long MaxImportFileBytes = 20 * 1024 * 1024;

    private const string DefaultBpmnXml = """
        <?xml version="1.0" encoding="UTF-8"?>
        <bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn">
          <bpmn2:process id="Process_1" isExecutable="false">
            <bpmn2:startEvent id="StartEvent_1" />
          </bpmn2:process>
          <bpmndi:BPMNDiagram id="BPMNDiagram_1">
            <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
              <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
                <dc:Bounds height="36.0" width="36.0" x="412.0" y="240.0" />
              </bpmndi:BPMNShape>
            </bpmndi:BPMNPlane>
          </bpmndi:BPMNDiagram>
        </bpmn2:definitions>
        """;
}
