@page "/"

<PageTitle>Home</PageTitle>

<section class="home-hero">
    <div>
        <span class="eyebrow">simpleXflow</span>
        <h1>Semi-formal simulation specification for teams.</h1>
        <p>
            A browser-based modeling workspace for architecture and logic views,
            explicit resources, queues, timing assumptions, and tenant-isolated project data.
        </p>
        <AuthorizeView>
            <Authorized>
                <a class="primary-action" href="projects">Open workspace</a>
            </Authorized>
            <NotAuthorized>
                <div class="action-row">
                    <a class="primary-action" href="Account/Register">Create account</a>
                    <a class="secondary-action" href="Account/Login">Login</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>
